<Window x:Class="Cleanup.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cleanup" Width="640" Height="540" MinWidth="480" MinHeight="360"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="CanResize"
        WindowStartupLocation="Manual">
  <!-- MouseLeftButtonDown on the Root background moves the window (drag anywhere);
       clicks that originate inside interactive controls are filtered out in code. -->
  <Border x:Name="Root" CornerRadius="12" BorderThickness="1" MouseLeftButtonDown="Root_MouseDown">
    <Grid>
    <DockPanel>
      <!-- title bar -->
      <Grid DockPanel.Dock="Top" Margin="14,9,14,9">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="TitleLabel" Text="Cleanup" FontSize="12" FontWeight="SemiBold"/>
        <Border x:Name="AutoBtn" Grid.Column="1" CornerRadius="5" BorderThickness="1"
                Padding="7,3" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonUp="Auto_Click"
                ToolTip="Auto — capture new selections as you highlight them">
          <TextBlock x:Name="AutoLabel" Text="⟳ auto" FontSize="11"/>
        </Border>
        <Border x:Name="ModelChip" Grid.Column="2" CornerRadius="5" BorderThickness="1"
                Padding="8,3" Margin="0,0,8,0" Cursor="Hand">
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="ModelLabel" FontSize="11" VerticalAlignment="Center"/>
            <TextBlock x:Name="ModelChipCaret" Text="&#xE70D;" FontSize="9"
                       FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                       VerticalAlignment="Center" Margin="4,1,0,0"/>
          </StackPanel>
        </Border>
        <Border x:Name="HelpBtn" Grid.Column="3" CornerRadius="5" BorderThickness="1"
                Padding="8,3" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonUp="Help_Click"
                ToolTip="Shortcuts &amp; tips (?)">
          <TextBlock x:Name="HelpLabel" Text="?" FontSize="11" FontWeight="SemiBold"/>
        </Border>
        <Border x:Name="CloseBtn" Grid.Column="4" CornerRadius="5" BorderThickness="1"
                Padding="7,3" Cursor="Hand" MouseLeftButtonUp="Close_Click"
                ToolTip="Close (Esc)">
          <TextBlock x:Name="CloseLabel" Text="✕" FontSize="11"/>
        </Border>
      </Grid>

      <!-- footer -->
      <Grid DockPanel.Dock="Bottom" Margin="14,9,14,9">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="HintLabel" FontSize="11" VerticalAlignment="Center"
                   Text="Ctrl+1–5 select · Ctrl+R regenerate · Esc cancel"/>
        <Border x:Name="CopyBtn" Grid.Column="1" CornerRadius="6" BorderThickness="1"
                Padding="12,5" Margin="0,0,10,0" Cursor="Hand" MouseLeftButtonUp="Copy_Click">
          <TextBlock x:Name="CopyLabel" Text="Copy" FontSize="12" FontWeight="SemiBold"/>
        </Border>
        <Border x:Name="ReplaceBtn" Grid.Column="2" CornerRadius="6"
                Padding="13,6" Cursor="Hand" MouseLeftButtonUp="Replace_Click">
          <TextBlock x:Name="ReplaceLabel" Text="Replace  Ctrl+↩" FontSize="12" FontWeight="SemiBold"/>
        </Border>
      </Grid>

      <!-- body -->
      <Grid Margin="14,5,14,5">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <WrapPanel x:Name="ChipsPanel" Grid.Row="0"/>
        <Grid Grid.Row="1" Margin="0,12,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="VariantsLabel" Text="VARIANTS" FontSize="10" FontFamily="Consolas"
                     VerticalAlignment="Center" Margin="0,0,12,0"/>
          <Slider x:Name="VariantSlider" Grid.Column="1" Minimum="1" Maximum="5"
                  TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                  ValueChanged="Slider_ValueChanged"/>
          <TextBlock x:Name="CountLabel" Grid.Column="2" FontSize="13" FontWeight="SemiBold"
                     FontFamily="Consolas" VerticalAlignment="Center" Margin="10,0,10,0"/>
          <TextBlock x:Name="ModeHint" Grid.Column="3" FontSize="11" VerticalAlignment="Center"/>
          <Border x:Name="DiffBtn" Grid.Column="4" CornerRadius="5" BorderThickness="1"
                  Padding="8,3" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonUp="Diff_Click"
                  ToolTip="Diff — show what the selected variant changes (Ctrl+D)">
            <TextBlock x:Name="DiffLabel" Text="◫ diff" FontSize="11"/>
          </Border>
          <Border x:Name="PopOutBtn" Grid.Column="5" CornerRadius="5" BorderThickness="1"
                  Padding="8,3" Cursor="Hand" MouseLeftButtonUp="PopOut_Click"
                  ToolTip="Pop out — open the red/green diff in a separate window">
            <TextBlock x:Name="PopOutLabel" Text="⧉ pop out" FontSize="11"/>
          </Border>
        </Grid>
        <ScrollViewer x:Name="CardsScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="CardsPanel"/>
        </ScrollViewer>
        <Border x:Name="DiffPanel" Grid.Row="3" CornerRadius="8" BorderThickness="1"
                Margin="0,12,0,0" Padding="10,7" Visibility="Collapsed">
          <RichTextBox x:Name="DiffBox" FontSize="13" IsReadOnly="True" IsDocumentEnabled="True"
                       BorderThickness="0" Background="Transparent" Padding="0" IsTabStop="False"
                       MaxHeight="140" VerticalScrollBarVisibility="Auto"
                       HorizontalScrollBarVisibility="Disabled"/>
        </Border>
        <Border x:Name="RefineBorder" Grid.Row="4" CornerRadius="8" BorderThickness="1" Margin="0,12,0,0" Padding="12,8">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="RefineBox" FontSize="13" BorderThickness="0" Background="Transparent"
                     KeyDown="RefineBox_KeyDown"/>
            <TextBlock x:Name="RefinePlaceholder" Text="tune it…" FontSize="13"
                       IsHitTestVisible="False" VerticalAlignment="Center"/>
            <TextBlock x:Name="RefineStatus" Grid.Column="1" Text="↵" FontSize="12"
                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"/>
          </Grid>
        </Border>
      </Grid>
    </DockPanel>

    <!-- help overlay: dim scrim + centered mono cheat-sheet; click-away / Esc / ? closes.
         Content is built + themed in code. -->
    <Border x:Name="HelpOverlay" CornerRadius="12" Visibility="Collapsed"
            MouseLeftButtonDown="HelpOverlay_Click">
      <Border x:Name="HelpCard" CornerRadius="10" BorderThickness="1"
              Padding="18,16" MaxWidth="420" MaxHeight="440"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              MouseLeftButtonDown="HelpCard_Click">
        <StackPanel x:Name="HelpContent"/>
      </Border>
    </Border>
    </Grid>
  </Border>
</Window>
