<Window x:Class="Cleanup.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cleanup Settings" Width="460" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
  <StackPanel Margin="20">
    <Grid Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="110"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="Backend" VerticalAlignment="Center"/>
      <ComboBox x:Name="BackendBox" Grid.Column="1" SelectionChanged="Backend_Changed">
        <ComboBoxItem Tag="ollama">Ollama (local)</ComboBoxItem>
        <ComboBoxItem Tag="chatgpt">ChatGPT subscription (Codex login)</ComboBoxItem>
        <ComboBoxItem Tag="claude">Claude subscription (Claude Code login)</ComboBoxItem>
        <ComboBoxItem Tag="openai">OpenAI-compatible API</ComboBoxItem>
      </ComboBox>
    </Grid>

    <StackPanel x:Name="OllamaPanel">
      <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Server URL" VerticalAlignment="Center"/>
        <TextBox x:Name="OllamaUrlBox" Grid.Column="1"/>
      </Grid>
      <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Model" VerticalAlignment="Center"/>
        <ComboBox x:Name="OllamaModelBox" Grid.Column="1" IsEditable="True"/>
      </Grid>
    </StackPanel>

    <StackPanel x:Name="ChatgptPanel">
      <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Model" VerticalAlignment="Center"/>
        <ComboBox x:Name="ChatgptModelBox" Grid.Column="1"/>
      </Grid>
      <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Reasoning" VerticalAlignment="Center"/>
        <ComboBox x:Name="ChatgptEffortBox" Grid.Column="1"/>
      </Grid>
      <TextBlock FontSize="11" Opacity="0.55" TextWrapping="Wrap" Margin="0,0,0,8"
                 Text="Low reasoning is ~3x faster for short rewrites. gpt-5.4-mini is the fastest model (~1s)."/>
      <Border Background="#14000000" CornerRadius="6" Padding="10" Margin="0,0,0,8">
        <TextBlock x:Name="CodexStatusLabel" FontSize="11.5" TextWrapping="Wrap"/>
      </Border>
    </StackPanel>

    <StackPanel x:Name="ClaudePanel">
      <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Model" VerticalAlignment="Center"/>
        <ComboBox x:Name="ClaudeModelBox" Grid.Column="1" IsEditable="True"/>
      </Grid>
      <TextBlock FontSize="11" Opacity="0.55" TextWrapping="Wrap" Margin="0,0,0,8"
                 Text="Uses your Claude Code subscription — no API key. Slower than API backends (~8-10s per rewrite; streaming softens it)."/>
      <Border Background="#14000000" CornerRadius="6" Padding="10" Margin="0,0,0,8">
        <TextBlock x:Name="ClaudeStatusLabel" FontSize="11.5" TextWrapping="Wrap"/>
      </Border>
    </StackPanel>

    <StackPanel x:Name="OpenaiPanel">
      <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Base URL" VerticalAlignment="Center"/>
        <TextBox x:Name="ApiBaseBox" Grid.Column="1"/>
      </Grid>
      <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="API key" VerticalAlignment="Center"/>
        <PasswordBox x:Name="ApiKeyBox" Grid.Column="1"/>
      </Grid>
      <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Model" VerticalAlignment="Center"/>
        <TextBox x:Name="ApiModelBox" Grid.Column="1"/>
      </Grid>
      <TextBlock FontSize="11" Opacity="0.55" TextWrapping="Wrap" Margin="0,0,0,8"
                 Text="OpenRouter: base https://openrouter.ai/api/v1, model needs a vendor prefix (e.g. openai/gpt-4o-mini). OpenAI: base https://api.openai.com."/>
    </StackPanel>

    <Separator Margin="0,8"/>

    <!-- Agent mode: independent of the rewrite backend above -->
    <TextBlock Text="Agent mode" FontWeight="SemiBold" Margin="0,4,0,8"/>
    <Grid Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="110"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="Engine" VerticalAlignment="Center"/>
      <ComboBox x:Name="AgentEngineBox" Grid.Column="1" SelectionChanged="AgentEngine_Changed">
        <ComboBoxItem Tag="codex">Codex (ChatGPT login)</ComboBoxItem>
        <ComboBoxItem Tag="claude">Claude (Claude Code login)</ComboBoxItem>
      </ComboBox>
    </Grid>
    <TextBlock FontSize="11" Opacity="0.55" TextWrapping="Wrap" Margin="0,0,0,8"
               Text="More engines coming soon (Ollama, API keys)."/>
    <Grid Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="110"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="Model" VerticalAlignment="Center"/>
      <ComboBox x:Name="AgentModelBox" Grid.Column="1" IsEditable="True"/>
    </Grid>
    <Grid Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="110"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="Permissions" VerticalAlignment="Center"/>
      <ComboBox x:Name="AgentPermBox" Grid.Column="1" SelectionChanged="AgentPerm_Changed">
        <ComboBoxItem Tag="safe">Safe — read &amp; analyze only</ComboBoxItem>
        <ComboBoxItem Tag="standard">Standard — can edit files</ComboBoxItem>
        <ComboBoxItem Tag="full">Full — no sandbox (dangerous)</ComboBoxItem>
      </ComboBox>
    </Grid>
    <TextBlock x:Name="AgentWarnLabel" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap"
               Margin="0,0,0,8" Visibility="Collapsed"
               Text="Full gives the agent unrestricted access to your machine. Use only when you trust the task."/>
    <Border Background="#14000000" CornerRadius="6" Padding="10" Margin="0,0,0,8">
      <TextBlock x:Name="AgentStatusLabel" FontSize="11.5" TextWrapping="Wrap"/>
    </Border>

    <Separator Margin="0,8"/>

    <Grid Margin="0,8,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="110"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="Default tone" VerticalAlignment="Center"/>
      <ComboBox x:Name="ToneBox" Grid.Column="1">
        <ComboBoxItem>Clean</ComboBoxItem>
        <ComboBoxItem>Professional</ComboBoxItem>
        <ComboBoxItem>Casual</ComboBoxItem>
        <ComboBoxItem>Blunt</ComboBoxItem>
      </ComboBox>
    </Grid>
    <Grid Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="110"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="Default variants" VerticalAlignment="Center"/>
      <ComboBox x:Name="CountBox" Grid.Column="1">
        <ComboBoxItem>1</ComboBoxItem>
        <ComboBoxItem>2</ComboBoxItem>
        <ComboBoxItem>3</ComboBoxItem>
        <ComboBoxItem>4</ComboBoxItem>
        <ComboBoxItem>5</ComboBoxItem>
      </ComboBox>
    </Grid>

    <Grid Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="110"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="Popup hotkey" VerticalAlignment="Center"/>
      <TextBox x:Name="HotkeyBox" Grid.Column="1" IsReadOnly="True" Cursor="Hand"
               PreviewKeyDown="Hotkey_KeyDown" GotFocus="Hotkey_GotFocus"/>
    </Grid>

    <Grid Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="110"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="Instant hotkey" VerticalAlignment="Center"/>
      <TextBox x:Name="HotkeyBox2" Grid.Column="1" IsReadOnly="True" Cursor="Hand"
               PreviewKeyDown="Hotkey2_KeyDown" GotFocus="Hotkey2_GotFocus"/>
    </Grid>

    <CheckBox x:Name="FloatingButtonCheck" Margin="0,0,0,6"
              Content="Show buttons when I select text with the mouse"
              Checked="FloatingButton_Changed" Unchecked="FloatingButton_Changed"/>
    <!-- Per-chip toggles; the whole panel greys out when the master is unchecked. -->
    <StackPanel x:Name="ChipTogglesPanel" Margin="18,0,0,8">
      <CheckBox x:Name="ChipStarCheck" Margin="0,0,0,4"
                Content="✦ Clean up (opens the popup)"/>
      <CheckBox x:Name="ChipBoltCheck" Margin="0,0,0,4"
                Content="⚡ Instant rewrite"/>
      <CheckBox x:Name="ChipAgentCheck"
                Content="🤖 Agent mode"/>
    </StackPanel>

    <Grid Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="110"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="Button size" VerticalAlignment="Center"/>
      <Slider x:Name="ButtonSizeSlider" Grid.Column="1" Minimum="22" Maximum="48"
              TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
              ValueChanged="ButtonSize_Changed"/>
      <TextBlock x:Name="ButtonSizeValue" Grid.Column="2" MinWidth="34"
                 TextAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0"/>
    </Grid>

    <Grid Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="110"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="Popup text size" VerticalAlignment="Center"/>
      <Slider x:Name="FontSizeSlider" Grid.Column="1" Minimum="11" Maximum="18"
              TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
              ValueChanged="FontSize_Changed"/>
      <TextBlock x:Name="FontSizeValue" Grid.Column="2" MinWidth="34"
                 TextAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0"/>
    </Grid>

    <CheckBox x:Name="AutoCloseCheck" Margin="0,0,0,8"
              Content="Auto-close when clicking away"/>

    <TextBlock x:Name="TriggerHint"
               FontSize="11" Foreground="Gray" Margin="0,4,0,12" TextWrapping="Wrap"/>

    <Separator Margin="0,4,0,8"/>

    <Grid Margin="0,0,0,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="110"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="Version" VerticalAlignment="Center"/>
      <TextBlock x:Name="VersionLabel" Grid.Column="1" VerticalAlignment="Center"/>
      <Button x:Name="UpdateBtn" Grid.Column="2" Content="Check for updates"
              Padding="10,4" Click="Update_Click"/>
    </Grid>
    <TextBlock x:Name="UpdateStatus" FontSize="11" Foreground="Gray" Margin="0,0,0,12"
               TextWrapping="Wrap" Visibility="Collapsed"/>

    <Button x:Name="SaveBtn" Content="Save" Width="90" HorizontalAlignment="Right"
            Padding="0,5" Click="Save_Click"/>
  </StackPanel>
</Window>
