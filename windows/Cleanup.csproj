<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Cleanup</AssemblyName>
    <RootNamespace>Cleanup</RootNamespace>
    <!-- per-monitor-v2 DPI awareness (see app.manifest). This is a WPF-first app,
         so the manifest is the authoritative place to declare DPI awareness; the
         WinForms analyzer (WFAC010) wrongly insists on the WinForms-only
         ApplicationHighDpiMode path, so we suppress just that one warning. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <!-- allows compiling this project on macOS/Linux for CI/verification -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- voice input for Agent mode (SpeechRecognitionEngine + DictationGrammar).
         Microsoft-owned; Windows-only at runtime (init is wrapped so a missing
         mic/recognizer just disables the mic button). -->
    <PackageReference Include="System.Speech" Version="8.0.0" />
    <!-- Windows Whiteboard: webcam capture + perspective correction, and AAC/WAV
         conversion for iPhone hold-to-talk uploads. -->
    <PackageReference Include="OpenCvSharp4.Windows" Version="4.13.0.20260627" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="Markdig" Version="1.3.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- In-process Kestrel HTTPS server for the token-protected iPhone remote. Unlike
         HttpListener HTTPS, this needs no admin-only netsh certificate binding. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
